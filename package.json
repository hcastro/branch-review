{
  "name": "branch-review",
  "version": "0.1.0",
  "description": "A PR-style review UI in your terminal for checking what you or a coding agent changed before it reaches GitHub.",
  "keywords": [
    "cli",
    "git",
    "diff",
    "branch",
    "review",
    "code-review",
    "ink",
    "delta",
    "terminal",
    "tui",
    "ai",
    "agents",
    "claude-code"
  ],
  "author": "hcastro",
  "license": "MIT",
  "homepage": "https://github.com/hcastro/branch-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hcastro/branch-review.git"
  },
  "bugs": {
    "url": "https://github.com/hcastro/branch-review/issues"
  },
  "type": "module",
  "bin": {
    "branch-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "docs",
    "src/rendered/assets/LICENSE-github-markdown-css",
    "src/rendered/assets/LICENSE-octicons",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "node scripts/inline-assets.mjs",
    "build": "tsup",
    "dev": "tsx src/cli.tsx",
    "pretest": "node scripts/inline-assets.mjs --check",
    "test": "vitest run --testTimeout 30000",
    "typecheck": "tsc --noEmit",
    "prepare": "node scripts/inline-assets.mjs && tsup"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@wooorm/starry-night": "^3.11.0",
    "@zenobius/ink-mouse": "^1.0.3",
    "chalk": "^5.6.2",
    "chokidar": "^4.0.3",
    "gemoji": "^8.1.0",
    "github-slugger": "^2.0.0",
    "ink": "^5.2.1",
    "micromark-util-normalize-identifier": "^2.0.1",
    "react": "^18.3.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "string-width": "^7.2.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.15.3",
    "@types/react": "^18.3.20",
    "esbuild": "^0.25.12",
    "ink-testing-library": "^4.0.0",
    "strip-ansi": "^7.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  },
  "packageManager": "pnpm@10.22.0+sha512.bf049efe995b28f527fd2b41ae0474ce29186f7edcb3bf545087bd61fbbebb2bf75362d1307fda09c2d288e1e499787ac12d4fcb617a974718a6051f2eee741c"
}
